# Build output (CMake + Ninja write everything here, so it can be regenerated)
build/
cmake-build-*/

# Compiled artifacts, in case something is built outside build/
*.exe
*.obj
*.o
*.a
*.lib
*.pdb
*.ilk
*.exp
*.out

# CMake files generated by an in-source configure (cmake . instead of -B build/debug)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt

# Local tooling
.cache/
.vs/
CMakeUserPresets.json
compile_commands.json